cabal-version:      3.0
name:               constructor
version:            0.3.1
synopsis:           Nested-data constructor language with universe-level inference
description:        A tiny finally-tagless language whose programs are nested
                    `data` declarations indexed by a universe ladder *0, *1, …
                    Designed as a substrate for experimenting with
                    hyperfunction-based unification.
license:            BSD-3-Clause
author:             Gabor Greif
maintainer:         ggreif@gmail.com
build-type:         Simple

common opts
  default-language: GHC2024
  ghc-options:      -Wall -Wcompat -Widentities -Wincomplete-record-updates
                    -Wincomplete-uni-patterns -Wpartial-fields -Wredundant-constraints

library
  import:          opts
  hs-source-dirs:  src
  exposed-modules:
    Constructor.Sort
    Constructor.Path
    Constructor.Level
    Constructor.Sheet
    Constructor.LevelInfer
    Constructor.HyperLite
    Constructor.HfLvl
    Constructor.Tc
    Constructor.HypLinf
    Constructor.TyExpr
    Constructor.Tinf
    Constructor.TyProc
    Constructor.HypTinf
    Constructor.HypTwr
    Constructor.Tower
    Constructor.Syntax
    Constructor.AST
    Constructor.Parser
    Constructor.Hs
    Constructor.Scott
    Constructor.HyperRise
    Constructor.Interp
  build-depends:
    , base        >= 4.18 && < 5
    , containers  >= 0.6  && < 0.9
    , mtl         >= 2.2  && < 2.4
    , text        >= 2.0  && < 2.2
    , megaparsec  >= 9.5  && < 9.8

executable constructor
  import:         opts
  hs-source-dirs: app
  main-is:        Main.hs
  build-depends:
    , base
    , constructor
    , containers
    , megaparsec
    , text

test-suite constructor-test
  import:         opts
  type:           exitcode-stdio-1.0
  hs-source-dirs: test
  main-is:        Spec.hs
  other-modules:
    LevelInferSpec
    TinfSpec
    TyProcSpec
    HypTinfSpec
    HypTwrSpec
    TowerSpec
    GadtSpec
    AxiomsSpec
    HsSpec
    ScottSpec
    InterpSpec
  build-depends:
    , base
    , constructor
    , containers
    , megaparsec
    , process
    , temporary
    , text
